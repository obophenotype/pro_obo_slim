comment: Category=family. Classification based on GRAFS system. [PMID:12761335]
synonym: "class 2 G-protein coupled receptor" BROAD [PMID:15914470]
synonym: "class B G-protein coupled receptor" EXACT [IUPHAR:GPCRListForward?class=B]
synonym: "fam:secretin" EXACT PRO-short-label [PRO:DAN]
synonym: "subfamily B1 G-protein coupled receptor" EXACT [PMID:11790261]
xref: IUPHAR:GPCRListForward?class=B
is_a: PR:000030035 ! G-protein coupled receptor

